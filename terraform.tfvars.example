# Required for the documented local workflow. Copy this file to terraform.tfvars,
# replace the placeholder, and never commit that file. The provider may instead
# read CLOUDFLARE_API_TOKEN in CI/automation.
cloudflare_api_token = "<CLOUDFLARE_API_TOKEN>"

# Cloudflare account and zone that own Zero Trust and the browser-RDP hostnames.
account_id = "<CLOUDFLARE_ACCOUNT_ID>"
zone_id    = "<CLOUDFLARE_ZONE_ID>"

# Existing Microsoft Entra identity provider UUID in Cloudflare Access.
existing_entra_idp_id = "<CLOUDFLARE_ENTRA_IDP_ID>"

# Reusable authorization boundaries. All servers selecting the same profile
# share one Access application, policy, hostname, port set, and clipboard rules.
rdp_access_profiles = {
  operators = {
    application_name   = "Customer Windows RDP"
    application_domain = "rdp.example.com"
    ports              = [3389]

    # For production, prefer Entra group Object IDs. For a pilot, use exact
    # emails instead and leave allowed_group_ids empty.
    allowed_group_ids = ["<ENTRA_GROUP_OBJECT_ID>"]
    allowed_emails    = []

    # Secure default: no text or file transfer in either direction.
    clipboard_local_to_remote_formats = []
    clipboard_remote_to_local_formats = []
  }
}

# Add one object per Windows machine. virtual_network_id is the Cloudflare Zero
# Trust VNet on the Tunnel route covering that IP, not an Azure VNet/GCP VPC ID.
rdp_servers = {
  gcp_windows = {
    hostname           = "gcp-windows"
    ipv4               = "10.168.0.27"
    virtual_network_id = "<CLOUDFLARE_VNET_FOR_GCP_ROUTE>"
    access_profile     = "operators"
  }

  helix_windows = {
    hostname           = "helix-windows"
    ipv4               = "10.7.0.6"
    virtual_network_id = "<CLOUDFLARE_VNET_FOR_HELIX_ROUTE>"
    access_profile     = "operators"
  }
}
